\[
\sum_{i=1}^n a_i(a_i + b_i) = (n-1)\left(\frac{1}{n-1} \cdot \left(\frac{1}{n-1} + \frac{1}{n-1}\right)\right) + \left(1 - (n-2)\frac{1}{n-1}\right) \cdot \left(1 - (n-2)\frac{1}{n-1} + \frac{1}{n-1}\right) = (n-1)\frac{2}{n-1} + \left(1 - \frac{n-2}{n-1}\right)\left(1 - \frac{n-3}{n-1}\right) = 2 + \frac{1}{n-1} \cdot \frac{3-n}{n-1} = 2 + \frac{3-n}{(n-1)^2},
